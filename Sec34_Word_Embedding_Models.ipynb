      "source": [
        "# Step 2: Compute word × word co-occurrence\n",
        "# Multiply transpose of document-term matrix with itself\n",
        "co_occurrence_matrix = (X.T @ X).toarray() #“How many times two words appear together in the same documents”\n",
        "\n",
        "co_occurrence_matrix\n",
        "\n",
        "df_co = pd.DataFrame(co_occurrence_matrix, index=words, columns=words)\n",
        "df_co"
