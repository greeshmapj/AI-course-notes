        "id": "rI1yX5ujXA6w"
      },
      "source": [
        "Chatbot Project (Without Deep Learning)\n",
        "🎯 Objective\n",
        "\n",
        "Create a rule-based + word embedding–powered chatbot that understands user queries using semantic similarity rather than keyword matching.\n",
        "\n",
        "🧩 Project Workflow\n",
        "\n",
        "📚 Data Preparation\n",
        "\n",
        "Collect a small dataset of sample user questions and corresponding bot responses.\n",
        "\n",
        "Example (FAQ style):\n",
        "\n",
        "User Query\tBot Response\n",
        "hi\tHello there! How can I help you?\n",
        "what is your name\tI’m a friendly chatbot built using Word2Vec!\n",
        "tell me about data science\tData science is the art of analyzing data to extract insights.\n",
        "\n",
        "🔤 Text Preprocessing\n",
        "\n",
        "Lowercasing\n",
        "\n",
        "Removing punctuation\n",
        "\n",
        "Tokenizing text"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "M3HIDMZumlMB",
        "outputId": "a4c2a8ae-29e0-49c6-a263-523fa80a36eb"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "🤖 Chatbot is online! Type 'exit' or 'quit' to stop.\n",
            "You: exit\n",
            "Chatbot: Goodbye! 👋\n"
          ]
        }
      ],
      "source": [
        "# ✅ Enhanced Chatbot Project: Rule-Based + Word2Vec\n",
        "\n",
        "import string\n",
        "from gensim.models import Word2Vec\n",
        "import numpy as np\n",
        "\n",
        "# 1️⃣ Sample dataset (FAQ style)\n",
        "dataset = [\n",
        "    {\"user\": \"hi\", \"bot\": \"Hello there! How can I help you?\"},\n",
        "    {\"user\": \"what is your name\", \"bot\": \"I’m a friendly chatbot built using Word2Vec!\"},\n",
        "    {\"user\": \"tell me about data science\", \"bot\": \"Data science is the art of data to extract insights.\"},\n",
        "    {\"user\": \"hello\", \"bot\": \"Hi! How can I assist you today?\"},\n",
        "    {\"user\": \"hey\", \"bot\": \"Hey there! What can I do for you?\"}\n",
        "]\n",
        "\n",
        "# 2️⃣ Text Preprocessing Function\n",
        "def preprocess(text):\n",
        "    \"\"\"\n",
        "    Lowercases text, removes punctuation, and tokenizes into words.\n",
        "    \"\"\"\n",
        "    text = text.lower()  # convert to lowercase\n",
        "    text = text.translate(str.maketrans(\"\", \"\", string.punctuation))  # remove punctuation\n",
        "    tokens = text.split()  # split text into words\n",
        "    return tokens\n",
        "\n",
        "# Preprocess dataset queries and responses\n",
        "for item in dataset:\n",
        "    item[\"user_tokens\"] = preprocess(item[\"user\"])  # tokenized user query\n",
        "    item[\"bot_tokens\"] = preprocess(item[\"bot\"])    # tokenized bot response\n",
        "\n",
        "# 3️⃣ Train Word2Vec model on all sentences (user queries + bot responses)\n",
        "all_sentences = [item[\"user_tokens\"] + item[\"bot_tokens\"] for item in dataset]\n",
        "model = Word2Vec(all_sentences, vector_size=50, window=2, min_count=1, sg=1)  # sg=1 → Skip-Gram\n",
        "\n",
        "# 4️⃣ Function to compute sentence vector by averaging word vectors\n",
        "def sentence_vector(tokens, model): #(words, Word2Vec)\n",
        "    \"\"\"\n",
        "    Computes the average vector of all words in a tokenized sentence.\n",
        "    If no words are in the model, returns a zero vector. (docstring)\n",
        "    \"\"\"\n",
        "\n",
        "    # 🔹 Step 1: Get the vector for each word in the sentence\n",
        "    # Only include words that exist in the model's vocabulary\n",
        "    vectors = [model.wv[word] for word in tokens if word in model.wv] #word by user\n",
        "\n",
        "    # 🔹 Step 2: Check if any word vectors were found\n",
        "    if vectors:\n",
        "        # ✅ Step 3: Compute the mean of all word vectors\n",
        "        # This gives a single vector representing the whole sentence\n",
        "        return np.mean(vectors, axis=0)\n",
        "    else:\n",
        "        # ⚠️ Step 4: If no words are in the vocabulary, return a zero vector\n",
        "        # This avoids errors and keeps the vector size consistent\n",
        "        return np.zeros(model.vector_size)\n",
        "\n",
        "\n",
        "# 5️⃣ Chatbot response function\n",
        "def get_bot_response(user_input):\n",
        "    \"\"\"\n",
        "    Returns the most similar bot response for a given user input\n",
        "    using Word2Vec semantic similarity.\n",
        "    \"\"\"\n",
        "\n",
        "    # 🔹 Step 1: Handle empty input\n",
        "    if not user_input.strip():  # if user input is empty or just spaces\n",
        "        return \"Please type something!\"\n",
        "\n",
        "    # 🔹 Step 2: Tokenize the user input\n",
        "    user_tokens = preprocess(user_input)  # convert input sentence to list of words\n",
        "\n",
        "    # 🔹 Step 3: Convert the tokenized input into a vector\n",
        "    user_vec = sentence_vector(user_tokens, model)  # average word vectors → sentence vector\n",
        "\n",
        "    # 🔹 Step 4: Initialize variables to find the best match\n",
        "    max_sim = -1  # highest cosine similarity found so far(no simila)\n",
        "    response = \"Sorry, I don't understand.\"  # default response if no match is found\n",
        "\n",
        "    # 🔹 Step 5: Compare input with each query in the dataset\n",
        "    for item in dataset:\n",
        "        item_vec = sentence_vector(item[\"user_tokens\"], model)  # vector for dataset query\n",
        "\n",
        "        # 🔹 Step 6: Compute cosine similarity between input and dataset query\n",
        "        sim = np.dot(user_vec, item_vec) / (np.linalg.norm(user_vec) * np.linalg.norm(item_vec) + 1e-8)\n",
        "\n",
        "        # 🔹 Step 7: Update response if similarity is higher than previous best\n",
        "        if sim > max_sim:\n",
        "            max_sim = sim\n",
        "            response = item[\"bot\"]\n",
        "\n",
        "    # 🔹 Step 8: Return the most similar bot response\n",
        "    return response\n",
        "\n",
        "\n",
        "# 6️⃣ Welcome message\n",
        "print(\"🤖 Chatbot is online! Type 'exit' or 'quit' to stop.\")\n",
        "\n",
        "# 7️⃣ Chat loop\n",
        "while True:\n",
        "    user_input = input(\"You: \")  # take user input\n",
        "    if user_input.lower() in [\"exit\", \"quit\"]:  # stop condition\n",
        "        print(\"Chatbot: Goodbye! 👋\")\n",
        "        break\n",
        "    bot_reply = get_bot_response(user_input)  # get response\n",
        "    print(\"Chatbot:\", bot_reply)\n"
      ]
    }
