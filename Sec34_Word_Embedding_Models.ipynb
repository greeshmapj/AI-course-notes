      "source": [
        "# 📘 Import the required library\n",
        "from gensim.models import Word2Vec # expect oov problem , technique: cbow, ski gram\n",
        "\n",
        "# ✅ Sample corpus (sentences)\n",
        "corpus = [\n",
        "    \"I love machine learning\",\n",
        "    \"Machine learning is fun\",\n",
        "    \"I love deep learning\"\n",
        "] #\n",
        "\n",
        "# 🔤 Step 1: Tokenize each sentence (split into words)\n",
        "tokenized_corpus = [sentence.lower().split() for sentence in corpus]\n",
        "print(\"✅ Tokenized Corpus:\")\n",
        "print(tokenized_corpus)\n",
        "\n",
        "# 🧠 Step 2: Train Word2Vec models\n",
        "# sg=1 True → Skip-Gram (predicts context words from target)\n",
        "# sg=0 False → CBOW (predicts target word from context)\n",
        "model_skipgram = Word2Vec(tokenized_corpus, vector_size=50, window=2, min_count=1, sg=1)  # Skip-Gram (surroundings)\n",
        "model_cbow = Word2Vec(tokenized_corpus, vector_size=50, window=2, min_count=1, sg=0)      # CBOW\n",
        "\"\"\" context koduthal words= cbow\n",
        "words koduthal context= skipgram\n",
        "\"\"\"\n",
        "\n",
        "\n",
        "# 🔍 Step 3: Get the vector representation for a specific word-\"learning\"\n",
        "# Each word is represented as a 50-dimensional numeric vector\n",
        "vector = model_skipgram.wv['learning'] #word vectors\n",
        "print(\"\\n🔹 Vector for 'learning':\\n\", vector)\n",
        "\n",
        "# 💬 Step 4: Find most similar words to a given word\n",
        "# The model uses cosine similarity to find words close in meaning\n",
        "similar_words = model_skipgram.wv.most_similar('learning', topn=3)\n",
        "\n",
        "# 📈 Step 5: Print the top 3 most similar words\n",
        "print(\"\\n🔹 Most similar words to 'learning':\")\n",
        "for word, score in similar_words:\n",
        "    print(f\"{word}: {score:.3f}\")\n",
        "\n",
        "#cbow  try it your selves"
      ]
